rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin'
        || (request.auth.token.email == 'mukuladavid6@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isSafeguardingLead() {
      return isAdmin()
        || (isSignedIn() && request.auth.token.role == 'coordinator' && request.auth.token.safeguardingCleared == true);
    }

    function isCoordinator() {
      return isAdmin() || (isSignedIn() && request.auth.token.role == 'coordinator');
    }

    function isLearningManager() {
      return isAdmin() || (isSignedIn() && request.auth.token.role == 'learning_manager');
    }

    function isInstructorOrManager() {
      return isLearningManager()
        || (isSignedIn() && (
          request.auth.token.role == 'instructor'
          || (request.auth.token.role == 'mentor' && request.auth.token.instructorAuthorized == true)
        ));
    }

    function isSafeImage() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isSafeDocument() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/(jpeg|png|webp)')
            || request.resource.contentType == 'application/pdf');
    }

    function isSafeLmsCourseMedia() {
      return request.resource != null
        && (
          (request.resource.contentType.matches('video/(mp4|webm|quicktime)') && request.resource.size <= 500 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/(mpeg|mp3|wav|ogg|aac|mp4|webm)') && request.resource.size <= 80 * 1024 * 1024)
          || (request.resource.contentType == 'application/pdf' && request.resource.size <= 40 * 1024 * 1024)
          || (request.resource.contentType in [
                'application/vnd.ms-powerpoint',
                'application/vnd.openxmlformats-officedocument.presentationml.presentation'
              ] && request.resource.size <= 50 * 1024 * 1024)
          || (request.resource.contentType in [
                'application/msword',
                'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
              ] && request.resource.size <= 30 * 1024 * 1024)
          || (request.resource.contentType.matches('image/(jpeg|png|webp)') && request.resource.size <= 10 * 1024 * 1024)
          || (request.resource.contentType in ['text/vtt', 'text/plain', 'application/x-subrip'] && request.resource.size <= 2 * 1024 * 1024)
        );
    }

    function isSafeSubmissionFile() {
      return request.resource != null
        && request.resource.size <= 30 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('image/(jpeg|png|webp)')
            || request.resource.contentType in [
              'application/msword',
              'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
              'application/vnd.openxmlformats-officedocument.presentationml.presentation'
            ]);
    }

    // 1. Private Profile Avatars: NEVER publicly accessible; restricted to owner or safeguarding leads
    match /avatars/{userId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isCoordinator());
      allow write: if isSignedIn() && request.auth.uid == userId && isSafeImage();
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // 2. Guardian Consent & Member Documents: Private per-user path
    match /documents/{userId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isCoordinator());
      allow write: if isSignedIn() && request.auth.uid == userId && isSafeDocument();
      allow delete: if isAdmin();
    }

    // 3. Mentor Application Credentials & Referee Uploads: Strictly applicant & vetting coordinators
    match /mentorApplications/{appId}/{fileName} {
      allow read: if isCoordinator()
        || (isSignedIn() && resource != null && resource.metadata.uploaderUid == request.auth.uid);
      allow write: if isSignedIn()
        && isSafeDocument()
        && request.resource.metadata.uploaderUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // 4. Partner Verification Documents
    match /partnerApplications/{appId}/{fileName} {
      allow read: if isCoordinator()
        || (isSignedIn() && resource != null && resource.metadata.uploaderUid == request.auth.uid);
      allow write: if isSignedIn()
        && isSafeDocument()
        && request.resource.metadata.uploaderUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // 5. Confidential Safeguarding Case Attachments: ONLY safeguarding-cleared leads & admins
    match /safeguarding/{caseId}/{fileName} {
      allow read: if isSafeguardingLead();
      allow write: if isSignedIn() && isSafeDocument();
      allow delete: if isAdmin();
    }

    // 6. Published Learning Resources & CMS Media
    match /learningResources/{resId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isCoordinator() && isSafeDocument();
      allow delete: if isAdmin();
    }

    match /publicCms/{assetType}/{fileName} {
      allow read: if resource != null && resource.metadata.cmsStatus == 'published';
      allow write: if isAdmin() && isSafeImage();
      allow delete: if isAdmin();
    }

    // 7. LMS Course Thumbnails (signed-in read or published course thumbnail metadata)
    match /lms/courses/{courseId}/thumbnails/{fileName} {
      allow read: if isSignedIn() || (resource != null && resource.metadata.cmsStatus == 'published');
      allow write: if isInstructorOrManager() && isSafeImage();
      allow delete: if isInstructorOrManager();
    }

    // 8. Private LMS Course Media Assets (Videos, PDFs, Slides, Audio, Notes, VTT Captions)
    // Enrolment/authorized access verified via getAuthorizedMediaUrl Cloud Function or Firestore-authenticated session.
    match /lms/courses/{courseId}/modules/{moduleId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isInstructorOrManager()
        && isSafeLmsCourseMedia()
        && request.resource.metadata.uploaderUid == request.auth.uid;
      allow delete: if isInstructorOrManager();
    }

    // 9. Private Learner Assignment Submissions
    match /lms/submissions/{courseId}/{userId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isInstructorOrManager());
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && isSafeSubmissionFile();
      allow delete: if isLearningManager() || (isSignedIn() && request.auth.uid == userId);
    }

    // Default Deny Everything Else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
