# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Cloud Firestore, Auth, Storage)
# In production, replace with your Firebase project credentials.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# reCAPTCHA Enterprise / App Check (optional in local development)
VITE_FIREBASE_RECAPTCHA_SITE_KEY=""

# Offline / Preview Demo Mode
# When Firebase keys are not provided, the platform automatically activates
# the interactive Uganda local demo store with realistic safeguarding data.
VITE_USE_DEMO_STORE="true"
