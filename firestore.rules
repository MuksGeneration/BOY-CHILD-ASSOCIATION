rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Helper Functions & Safeguarding Access Control
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getUserDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function currentUserData() {
      return isSignedIn() ? getUserDoc(request.auth.uid) : null;
    }

    function hasRole(role) {
      return isSignedIn() && currentUserData() != null && currentUserData().role == role;
    }

    function isCoordinator() {
      return hasRole('coordinator');
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isSafeguardingLead() {
      return isCoordinator() || isAdmin();
    }

    function isMentor() {
      return hasRole('mentor');
    }

    function isGuardian() {
      return hasRole('guardian');
    }

    // Safeguarding: A minor pending guardian consent cannot access circle threads
    function isApprovedMember(uid) {
      let u = getUserDoc(uid);
      return u != null && u.status == 'active';
    }

    // -------------------------------------------------------------
    // 1. Users Collection
    // -------------------------------------------------------------
    match /users/{uid} {
      // Users can read their own profile; Safeguarding leads and admins can read any profile
      allow read: if isUser(uid) || isSafeguardingLead();

      // Creation on sign-up: role MUST be 'boy' or 'guardian'. Elevated roles require Admin
      allow create: if isUser(uid)
                    && request.resource.data.role in ['boy', 'guardian']
                    && request.resource.data.status in ['active', 'pending_guardian_consent']
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;

      // Updates: A user can NEVER change their own role or status. Elevated roles can only be set by admin
      allow update: if (isUser(uid)
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.updatedAt == request.time)
                    || isAdmin();

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 2. Member Profiles (Deep Safeguarding Profile)
    // -------------------------------------------------------------
    match /memberProfiles/{memberId} {
      allow read: if isUser(memberId) 
                  || isSafeguardingLead()
                  // Guardian can read linked boy's profile
                  || (isGuardian() && exists(/databases/$(database)/documents/guardianLinks/$(request.auth.uid + '_' + memberId)))
                  // Mentor can read boys in their assigned circles
                  || (isMentor() && resource.data.circleId != null && exists(/databases/$(database)/documents/circles/$(resource.data.circleId)/mentors/$(request.auth.uid)));

      allow write: if (isUser(memberId) && request.resource.data.role == 'boy')
                   || isSafeguardingLead();
    }

    // -------------------------------------------------------------
    // 3. Guardian Links & Consents (Uganda Child Law compliance)
    // -------------------------------------------------------------
    match /guardianLinks/{linkId} {
      allow read: if isSafeguardingLead() 
                  || (isSignedIn() && (resource.data.guardianId == request.auth.uid || resource.data.boyId == request.auth.uid));

      allow create, update: if isSafeguardingLead()
                            || (isGuardian() && request.resource.data.guardianId == request.auth.uid);

      allow delete: if isSafeguardingLead();
    }

    match /consents/{consentId} {
      allow read: if isSafeguardingLead()
                  || (isSignedIn() && (resource.data.guardianId == request.auth.uid || resource.data.boyId == request.auth.uid));

      allow create: if isGuardian() && request.resource.data.guardianId == request.auth.uid;
      allow update: if isSafeguardingLead();
      allow delete: if false; // Consents are immutable legal records
    }

    // -------------------------------------------------------------
    // 4. Programmes & Circles
    // -------------------------------------------------------------
    match /programmes/{programmeId} {
      allow read: if true; // Public programme catalogue
      allow write: if isSafeguardingLead();
    }

    match /circles/{circleId} {
      // Circles are visible to all authenticated active members, guardians, mentors and leads
      allow read: if isSignedIn();
      allow write: if isSafeguardingLead();

      // Nested mentors assignment subcollection
      match /mentors/{mentorId} {
        allow read: if isSignedIn();
        allow write: if isSafeguardingLead();
      }
    }

    match /circleMembers/{memberId} {
      allow read: if isSafeguardingLead()
                  || (isMentor() && exists(/databases/$(database)/documents/circles/$(resource.data.circleId)/mentors/$(request.auth.uid)))
                  || (isUser(resource.data.userId))
                  || (isGuardian() && exists(/databases/$(database)/documents/guardianLinks/$(request.auth.uid + '_' + resource.data.userId)));

      allow create, update, delete: if isSafeguardingLead();
    }

    // -------------------------------------------------------------
    // 5. Circle Sessions & Goals
    // -------------------------------------------------------------
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow write: if isSafeguardingLead() || isMentor();
    }

    match /goals/{goalId} {
      allow read: if isSafeguardingLead()
                  || isUser(resource.data.userId)
                  || (isGuardian() && exists(/databases/$(database)/documents/guardianLinks/$(request.auth.uid + '_' + resource.data.userId)))
                  || (isMentor() && resource.data.circleId != null && exists(/databases/$(database)/documents/circles/$(resource.data.circleId)/mentors/$(request.auth.uid)));

      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isUser(resource.data.userId) || isMentor() || isSafeguardingLead();
      allow delete: if isUser(resource.data.userId) || isSafeguardingLead();
    }

    // -------------------------------------------------------------
    // 6. Ask a Mentor Questions & Moderated Responses
    // -------------------------------------------------------------
    match /questions/{questionId} {
      allow read: if isSafeguardingLead()
                  || isUser(resource.data.userId)
                  || (isMentor() && exists(/databases/$(database)/documents/circles/$(resource.data.circleId)/mentors/$(request.auth.uid)));

      // Must be an active member who is not pending consent
      allow create: if isSignedIn() 
                    && isApprovedMember(request.auth.uid)
                    && request.resource.data.question.size() >= 10
                    && request.resource.data.question.size() <= 1000;

      allow update: if isSafeguardingLead() || isMentor();
      allow delete: if isSafeguardingLead();
    }

    // -------------------------------------------------------------
    // 7. Safeguarding Concern Reports (Strict Confidentiality)
    // -------------------------------------------------------------
    match /concernReports/{reportId} {
      // Anyone can submit a concern report (including anonymous or signed-in)
      allow create: if request.resource.data.details.size() >= 10
                    && request.resource.data.details.size() <= 2000
                    && request.resource.data.urgency in ['low', 'medium', 'high', 'immediate'];

      // STRICT PRIVACY: ONLY coordinators and admins can read or triage concern reports
      allow read, update: if isSafeguardingLead();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 8. Join Requests & Mentor Applications
    // -------------------------------------------------------------
    match /joinRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isSafeguardingLead();
    }

    match /mentorApplications/{appId} {
      allow create: if true;
      allow read, update, delete: if isSafeguardingLead();
    }

    // -------------------------------------------------------------
    // 9. Audit Log (Tamper-evident administrative audit trail)
    // -------------------------------------------------------------
    match /auditLog/{logId} {
      allow read: if isAdmin();
      // System and coordinators can append to audit log
      allow create: if isSafeguardingLead()
                    && request.resource.data.timestamp == request.time;
      allow update, delete: if false; // Append-only immutable log
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
